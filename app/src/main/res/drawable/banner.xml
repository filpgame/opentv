<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV home-screen banner, the launcher icon at 16:9. Must be 320x180; the launcher does not
  letterbox. The gradient is a shape rather than a vector fill because vector gradients need API 24
  and minSdk is 23.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2B7ACE"
                android:centerColor="#318FEF"
                android:endColor="#3292F5" />
        </shape>
    </item>
    <item android:drawable="@drawable/banner_play" />
</layer-list>
