    <!-- ============================ About ============================ -->
    <string name="about_title">About OpenTV</string>
    <string name="about_version">Version</string>
    <string name="about_update_available">Update available: %1$s — see the prompt to install.</string>
    <string name="about_up_to_date">You\'re on the latest version.</string>
    <string name="about_checking">Checking…</string>
    <string name="about_check_updates">Check for updates</string>
    <string name="about_what_is_title">What it is</string>
    <string name="about_what_is_body">A free, open-source IPTV player for Android TV, Fire TV and phones. It\'s a player only — it doesn\'t supply channels; you connect the service you already pay for. Nothing you enter leaves your device except to talk to your own provider.</string>
    <string name="about_built_open_title">Built in the open</string>
    <string name="about_built_open_body">OpenTV is developed openly, with AI doing a large share of the coding under human direction — that\'s stated plainly, not hidden. Because it\'s open source, no single person going away can take it down: anyone can read every line, build it, and carry it on.</string>
    <string name="about_support_title">Support the project</string>
    <string name="about_support_body">OpenTV is free and always will be — nothing is gated. If it\'s useful and you\'d like to chip in, GitHub Sponsors or a one-off tip keeps the updates coming: new features, fixes and support all come out of spare evenings. Entirely optional, and genuinely appreciated.</string>
    <string name="about_sponsor_github">GitHub Sponsors</string>
